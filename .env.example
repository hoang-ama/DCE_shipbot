# --- SERVER & RUNTIME ---
PORT=3000
NODE_ENV=production

# APP_URL: URL công khai của ứng dụng (ví dụ: https://shipbot.example.com)
APP_URL="http://localhost:3000"

# --- GEMINI AI ---
# GEMINI_API_KEY: Bắt buộc để dùng Gemini 3.8 Flash; nếu trống sẽ fallback về regex NLP
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- POSTGRESQL ---
POSTGRES_USER=shipbot
POSTGRES_PASSWORD=shipbot_secret
POSTGRES_DB=shipbot_db
# Với Docker Compose, host của DB là tên service "postgres"
DATABASE_URL="postgresql://shipbot:shipbot_secret@postgres:5432/shipbot_db"

# --- ZALO OFFICIAL ACCOUNT (OpenAPI v4) ---
ZALO_APP_ID=""
ZALO_APP_SECRET=""
ZALO_OA_ACCESS_TOKEN=""
ZALO_REFRESH_TOKEN=""
