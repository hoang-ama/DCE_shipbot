# --- SERVER & RUNTIME ---
PORT=2700
HOST=0.0.0.0
NODE_ENV=production

# APP_URL: URL công khai của ứng dụng (ví dụ: https://ai.dichung.vn)
APP_URL="http://localhost:2700"

# ADMIN_PASSCODE: Mật khẩu / API Key bảo vệ CRM, Đơn hàng, Cấu hình và Zalo OAuth trên Web UI
# Để trống nếu tạm thời không bật khóa đăng nhập nội bộ
ADMIN_PASSCODE=""

# --- GEMINI AI ---
# GEMINI_API_KEY: Bắt buộc để dùng Gemini 3.8 Flash; nếu trống sẽ fallback về regex NLP
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- POSTGRESQL ---
POSTGRES_USER=shipbot
POSTGRES_PASSWORD=shipbot_secret
POSTGRES_DB=shipbot_db
POSTGRES_PORT=2732
# Với Docker Compose, host của DB là tên service "postgres"
DATABASE_URL="postgresql://shipbot:shipbot_secret@postgres:2732/shipbot_db"

# --- ZALO OFFICIAL ACCOUNT (OpenAPI v4) ---
ZALO_APP_ID=""
ZALO_APP_SECRET=""
ZALO_OA_ACCESS_TOKEN=""
ZALO_REFRESH_TOKEN=""

